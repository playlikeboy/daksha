{
  // debo-os-app: the Expo web export as static assets, with single-page-app fallback.
  // Build first (EXPO_PUBLIC_API_URL is baked in at build time):
  //   EXPO_PUBLIC_API_URL=https://debo-os-api.<account>.workers.dev pnpm build:web   (in os/)
  //   npx wrangler deploy -c app/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "debo-os-app",
  // A small Worker in front of the files: it answers my.debo.life with a 307 to my.daksha.life
  // and hands everything else to the files (src/redirect.ts, docs/DOMAINS.md).
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // my.daksha.life is the app. my.debo.life is the address from before the rename; every request
  // there gets a 307 to the same path and query on my.daksha.life.
  "routes": [
    { "pattern": "my.daksha.life", "custom_domain": true },
    { "pattern": "my.debo.life", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../../apps/mobile/dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker first even when a file matches, so files on my.debo.life move too.
    "run_worker_first": true
  }
}
