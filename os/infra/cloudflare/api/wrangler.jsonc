{
  // debo-os-api: a Worker that fronts one container running the Daksha OS API
  // (Hono + in-process task worker). Run from os/infra/cloudflare:
  //   npx wrangler deploy -c api/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "debo-os-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Preview first: reachable at https://debo-os-api.<account>.workers.dev
  "workers_dev": true,
  "preview_urls": false,

  // The API's public address. The deploy workflow passes PUBLIC_API_URL and
  // ALLOWED_ORIGINS (https://my.daksha.life, then the old https://my.debo.life) to match.
  // api.debo.life is the address from before the rename (docs/RENAME.md). Phone apps already
  // installed have it built in, so it must keep working.
  "routes": [
    { "pattern": "api.daksha.life", "custom_domain": true },
    { "pattern": "api.debo.life", "custom_domain": true }
  ],

  "containers": [
    {
      "class_name": "DeboApi",
      "image": "./Dockerfile",
      // The repo root: the API imports TypeScript packages from ../packages.
      "image_build_context": "../../../..",
      // basic = 1/4 vCPU, 1 GiB. The API is one bundled file and does not start PGlite when DATABASE_URL is set.
      // If it runs out of memory, use "standard-1" (1/2 vCPU, 4 GiB).
      "instance_type": "basic",
      // Run one API instance (upstream rule). The Worker always addresses the same one.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "DeboApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeboApi"] }],

  // Private path to the browser worker. No public URL is involved.
  "services": [{ "binding": "BROWSER", "service": "debo-os-browser" }],

  // Voice notes and videos, with no keys or tokens: the private bucket and Workers AI as bindings.
  // The API container reaches them only through media.internal and ai.internal (see src/index.ts).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "debo-journal-media" }],
  "ai": { "binding": "AI" },

  // Keeps durable tasks moving: wakes the container, which restarts the task loop.
  // Remove to let the container sleep when idle (tasks then wait for the next visit).
  "triggers": { "crons": ["*/5 * * * *"] },

  "observability": { "enabled": true },

  "vars": {
    "WORKSPACE_MODE": "live",
    "AGENT_BACKEND": "model",
    // An Anthropic model, so no OpenAI key is needed. Same family the journal uses.
    "MODEL": "anthropic/claude-haiku-5-5",
    "AUTH_MODE": "neon",
    // os keeps its own table, os.records, in this schema of Daksha's Neon database.
    "OS_DB_SCHEMA": "os",
    "TASK_WORKER_ENABLED": "true",
    "TRUST_PROXY": "true",
    "API_SLEEP_AFTER": "10m",
    // Only used if the optional R2 keys are set (presigned links mode). Binding mode uses the MEDIA binding above.
    "R2_BUCKET": "debo-journal-media",
    // Overridden at deploy time with --var (the workflow does this).
    "PUBLIC_API_URL": "https://debo-os-api.workers.dev",
    "ALLOWED_ORIGINS": "https://debo-os-app.workers.dev"
  }
  // Secrets are set with `wrangler secret put` or --secrets-file, never here.
  // See ../README.md for the full list.
}
