{
  "expo": {
    "name": "Daksha",
    "slug": "debo",
    "scheme": "debo",
    "icon": "./assets/debo.png",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "life.debo.app",
      "infoPlist": { "UIBackgroundModes": ["audio"] }
    },
    "android": {
      "package": "life.debo.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": { "bundler": "metro", "name": "Daksha: remembers your life" },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Daksha uses the microphone only while you talk to it or record a note. The sound of a call is never kept. A note you record is kept until you delete it."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Daksha uses the microphone only while you talk to it or record a note. The sound of a call is never kept. A note you record is kept until you delete it."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Daksha uses the camera only while you record a video note. The video is kept until you delete it.",
          "microphonePermission": "Daksha uses the microphone only while you talk to it or record a note. The sound of a call is never kept. A note you record is kept until you delete it.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/with-call-service",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Figtree_400Regular.ttf",
              "./assets/fonts/Figtree_500Medium.ttf",
              "./assets/fonts/Figtree_600SemiBold.ttf",
              "./assets/fonts/Figtree_700Bold.ttf",
              "./assets/fonts/BricolageGrotesque_700Bold.ttf",
              "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Figtree_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Figtree_500Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Figtree_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Figtree_700Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "Bricolage Grotesque",
                "fontDefinitions": [
                  { "path": "./assets/fonts/BricolageGrotesque_700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf", "weight": 800 }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
