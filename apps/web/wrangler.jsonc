{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Next.js on Cloudflare Workers through the OpenNext adapter.
  // See docs/DECISIONS.md and docs/SETUP.md.
  "name": "debo-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // daksha.life serves /privacy and every /api/* route (the Neon Auth sign-in email webhook,
  // voice, export, delete account); its pages send people to the landing page at
  // www.daksha.life and the old screens to my.daksha.life (src/proxy.ts, docs/DOMAINS.md).
  // www.daksha.life is NOT here: it is the landing page, on debo-site (apps/site/wrangler.jsonc).
  // A custom domain can only be on one Worker.
  // debo.life and www.debo.life are the addresses from before the rename. Their pages send
  // people on to daksha.life, and /api/* keeps working there, so old webhook addresses work.
  "routes": [
    { "pattern": "daksha.life", "custom_domain": true },
    { "pattern": "debo.life", "custom_domain": true },
    { "pattern": "www.debo.life", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding the OpenNext adapter uses; name must match the worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "debo-web"
    }
  ],
  "hyperdrive": [
    {
      // Pools connections to Neon Postgres (direct, non-pooled connection string).
      // For local `preview`, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "binding": "HYPERDRIVE",
      "id": "c242d9f9452e495baac54cc4019ce392"
    }
  ]
}
