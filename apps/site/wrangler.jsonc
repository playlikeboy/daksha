{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The daksha.life landing page: Next.js on Cloudflare Workers through OpenNext.
  // Served at about.daksha.life. The app itself is at my.daksha.life.
  "name": "debo-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // about.debo.life is the address from before the rename (docs/RENAME.md), kept so old links work.
  "routes": [
    { "pattern": "about.daksha.life", "custom_domain": true },
    { "pattern": "about.debo.life", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding the OpenNext adapter uses; name must match the worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "debo-site"
    }
  ]
}
